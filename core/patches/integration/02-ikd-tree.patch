 template <typename PointType>
+// Await boundary quiescence.
+void KD_TREE<PointType>::wait_for_pending_rebuild()
+{
+    while (true)
+    {
+        pthread_mutex_lock(&rebuild_ptr_mutex_lock);
+        const bool pending = Rebuild_Ptr != nullptr;
+        pthread_mutex_unlock(&rebuild_ptr_mutex_lock);
+        if (!pending)
+        {
+            return;
+        }
+        // Await pending rebuilds.
+        usleep(100);
+    }
+}
