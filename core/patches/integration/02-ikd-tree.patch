 template <typename PointType>
+// resple_bridge: quiescence barrier for the offline bridge -- blocks until no
+// background subtree rebuild is pending or in flight, so a correspondence
+// search never races one. Called per measurement batch (01-resple-node.patch).
+void KD_TREE<PointType>::wait_for_pending_rebuild()
+{
+    while (true)
+    {
+        pthread_mutex_lock(&rebuild_ptr_mutex_lock);
+        const bool pending = Rebuild_Ptr != nullptr;
+        pthread_mutex_unlock(&rebuild_ptr_mutex_lock);
+        if (!pending)
+        {
+            return;
+        }
+        // The rebuild worker polls on this interval. Yielding here lets a
+        // queued job acquire the mutex; the next lock then blocks through
+        // the active rebuild and rechecks its state.
+        usleep(100);
+    }
+}
